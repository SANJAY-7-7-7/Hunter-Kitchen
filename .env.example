# ==============================================================================
# HUNTER'S KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server & Network
PORT=3000
NODE_ENV=production
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Primary Database Configuration (Supabase Free Tier / Cloud)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Preferred in Cloud / Production / Render)
# For Supabase Free Tier (Connection Pooler):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hunters_kitchen

# Option B: Individual Connection Parameters (Used when DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hunters_kitchen
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# Redis Fast L1/L2 Cache, Rate-Limiting & Session Invalidation Store
# ------------------------------------------------------------------------------
# Optional: In-memory fallback is automatically engaged if Redis server is unreachable
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# JWT & Session Security (Must be high-entropy strings, min 32 characters in production)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_64_char_random_hex_jwt_secret_in_production_hunter_2026
SESSION_COOKIE_SECRET=replace_with_64_char_random_cookie_signing_secret_hunter_2026

# ------------------------------------------------------------------------------
# Payment Gateway & Webhook Verification (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API Credentials (required in production)
RAZORPAY_KEY_ID=rzp_live_replace_with_actual_key_id
RAZORPAY_KEY_SECRET=replace_with_actual_razorpay_secret_min_16_chars

# Webhook Secret for HMAC-SHA256 signature validation (required in production, min 24 chars)
WEBHOOK_SECRET=replace_with_actual_webhook_secret_min_24_chars_hunter_2026

# ------------------------------------------------------------------------------
# Google Maps Platform API Key (Geocoding & Autocomplete)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_PLATFORM_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Authorization Code Flow)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------------------
# Gmail Real-Time OTP Verification Service
# ------------------------------------------------------------------------------
# Generate App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# Gemini AI Assistant (Menu Recommendations & Dish Pairing)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
